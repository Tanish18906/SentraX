# SentraX AI Environment Configuration

# OpenAI API Key (used for Strategist and Remediation agents)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional alternative for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default LLM Provider: "openai" or "anthropic" (default: openai)
SENTRAX_LLM_PROVIDER=openai

# Model selection (default: gpt-4o-mini or claude-3-5-sonnet-latest)
SENTRAX_LLM_MODEL=gpt-4o-mini
